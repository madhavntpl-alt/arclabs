{
  "name": "arc-labs-monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "ARC LABS Environmental Monitoring Platform",
  "scripts": {
    "dev": "concurrently \"pnpm:dev:frontend\" \"pnpm:dev:backend\"",
    "dev:frontend": "pnpm --filter @arc-labs/frontend dev",
    "dev:backend": "pnpm --filter @arc-labs/backend dev",
    "build": "pnpm --filter @arc-labs/shared build && pnpm --filter @arc-labs/frontend build && pnpm --filter @arc-labs/backend build",
    "build:frontend": "pnpm --filter @arc-labs/frontend build",
    "build:backend": "pnpm --filter @arc-labs/backend build",
    "build:firmware": "cd firmware && pio run",
    "test": "pnpm --filter @arc-labs/shared test && pnpm --filter @arc-labs/frontend test && pnpm --filter @arc-labs/backend test",
    "test:frontend": "pnpm --filter @arc-labs/frontend test",
    "test:backend": "pnpm --filter @arc-labs/backend test",
    "test:firmware": "cd firmware && pio test",
    "test:e2e": "pnpm --filter @arc-labs/frontend test:e2e",
    "lint": "pnpm --filter @arc-labs/shared lint && pnpm --filter @arc-labs/frontend lint && pnpm --filter @arc-labs/backend lint",
    "lint:fix": "pnpm --filter @arc-labs/shared lint:fix && pnpm --filter @arc-labs/frontend lint:fix && pnpm --filter @arc-labs/backend lint:fix",
    "typecheck": "pnpm --filter @arc-labs/shared typecheck && pnpm --filter @arc-labs/frontend typecheck && pnpm --filter @arc-labs/backend typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "prepare": "husky install",
    "docker:dev": "docker-compose up --build",
    "docker:dev:down": "docker-compose down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "db:migrate": "pnpm --filter @arc-labs/backend db:migrate",
    "db:seed": "pnpm --filter @arc-labs/backend db:seed",
    "db:backup": "pnpm --filter @arc-labs/backend db:backup"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "husky": "^8.0.3",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.14.0"
}