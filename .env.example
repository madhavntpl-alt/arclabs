# =============================================================================
# ARC LABS Monitoring Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="ARC LABS Monitoring"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000/ws/live

# -----------------------------------------------------------------------------
# Frontend (Vite/React)
# -----------------------------------------------------------------------------
VITE_APP_NAME="ARC LABS Monitoring"
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# Database
DATABASE_URL=sqlite+aiosqlite:///./data/arc_labs.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arc_labs

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Serial Communication
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1.0
SERIAL_MOCK=false

# Sensor Thresholds (default values, override via API)
WATER_LEVEL_MIN_CM=10
WATER_LEVEL_MAX_CM=200
TEMP_MIN_C=0
TEMP_MAX_C=50
HUMIDITY_MIN_PCT=20
HUMIDITY_MAX_PCT=80
GAS_THRESHOLD_PPM=1000
BATTERY_MIN_V=3.3
BATTERY_MAX_V=4.2

# Automation
AUTOMATION_ENABLED=true
AUTOMATION_COOLDOWN_SECONDS=60
SAFETY_INTERLOCK_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Hardware / Firmware
# -----------------------------------------------------------------------------
# Arduino/PlatformIO
PLATFORMIO_ENV=uno
ARDUINO_BOARD=uno
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUDRATE=115200

# Pin Definitions (match firmware/src/config/pins.h)
PIN_WATER_LEVEL=A0
PIN_GAS_SENSOR=A1
PIN_DHT11=2
PIN_BATTERY_VOLTAGE=A2
PIN_RELAY_PUMP=3
PIN_RELAY_VALVE=4
PIN_RFID_SS=10
PIN_RFID_RST=9
PIN_LED_STATUS=13
PIN_BUZZER=5

# -----------------------------------------------------------------------------
# Deployment (Production)
# -----------------------------------------------------------------------------
# Vercel (Frontend)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TOKEN=

# Docker Registry
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=arc-labs/backend
DOCKER_IMAGE_TAG=latest

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4

# Database (Production PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arc_labs
POSTGRES_USER=arc_labs
POSTGRES_PASSWORD=change-me

# Redis (for caching/sessions - optional)
REDIS_URL=redis://localhost:6379/0

# Monitoring
SENTRY_DSN=
PROMETHEUS_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_DARK_MODE=true
FEATURE_OFFLINE_QUEUE=true
FEATURE_PWA=true
FEATURE_AUTOMATION_RULES=true
FEATURE_CALIBRATION=true